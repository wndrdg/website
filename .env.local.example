# ============================================================
# Existing marketing/admin vars — already set in Vercel, keep as-is
# ============================================================
# Vercel Blob (stores waitlist signups and invite codes)
BLOB_READ_WRITE_TOKEN=

# Resend (waitlist signup notifications to hr@wonder.dog)
RESEND_API_KEY=

# Google Places API (optional — enables /wl address autocomplete)
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=

# ============================================================
# CRM vars — new, required for /dashboard and CRM API routes
# (served on spark.wonder.dog)
# ============================================================
# Supabase (CRM tables prefixed `crm_*`)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Twilio (CRM SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# App URL (used by CRM for absolute links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
